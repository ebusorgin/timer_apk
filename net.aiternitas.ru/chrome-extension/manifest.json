{
  "manifest_version": 3,
  "name": "net.aiternitas.ru — Bluetooth и Wi‑Fi",
  "version": "1.0.0",
  "description": "Состояние Bluetooth, Wi‑Fi и поиск BLE-устройств для net.aiternitas.ru",
  "permissions": ["activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    },
    "default_title": "net.aiternitas.ru — каналы"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
