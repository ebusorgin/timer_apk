generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id       Int     @id @default(autoincrement())
  username String  @unique
  password String
  config   Config?
}

model Config {
  id          Int    @id @default(autoincrement())
  privateKey  String
  publicKey   String
  address     String
  exitCountry String @default("de")
  userId      Int    @unique
  user        User   @relation(fields: [userId], references: [id])
}
