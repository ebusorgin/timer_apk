# Redis — кэш онлайн-пользователей (опционально)
REDIS_URL=redis://localhost:6379

# Админка — логин и пароль для расширенного интерфейса
ADMIN_LOGIN=admin
ADMIN_PASSWORD=your-secure-password

# Push-уведомления (contact requests, звонки когда приложение закрыто)
# Сгенерировать: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:conference@aiternitas.ru

# FCM для full-screen входящих звонков (APK). Путь к firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_PATH=./server/firebase-service-account.json
